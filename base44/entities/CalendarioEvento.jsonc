{
  "name": "CalendarioEvento",
  "type": "object",
  "properties": {
    "usuario_id": {
      "type": "string",
      "description": "Email do usu\u00e1rio dono do evento"
    },
    "student_id": {
      "type": "string",
      "description": "ID do aluno vinculado"
    },
    "student_email": {
      "type": "string",
      "description": "Email do aluno vinculado"
    },
    "personal_id": {
      "type": "string",
      "description": "Email do personal vinculado"
    },
    "payment_id": {
      "type": "string",
      "description": "Lan\u00e7amento financeiro vinculado"
    },
    "class_value": {
      "type": "number",
      "description": "Valor individual da aula"
    },
    "duration_minutes": {
      "type": "number",
      "description": "Dura\u00e7\u00e3o da aula em minutos"
    },
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo do evento"
    },
    "descricao": {
      "type": "string"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "treino",
        "dieta",
        "checkin",
        "avaliacao",
        "tarefa",
        "lembrete",
        "pagamento",
        "consulta",
        "outro"
      ],
      "default": "tarefa"
    },
    "data": {
      "type": "string",
      "format": "date"
    },
    "horario": {
      "type": "string",
      "description": "HH:MM"
    },
    "recorrencia": {
      "type": "string",
      "enum": [
        "nenhuma",
        "diaria",
        "semanal",
        "mensal"
      ],
      "default": "nenhuma"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "concluido",
        "cancelado"
      ],
      "default": "pendente"
    },
    "cor": {
      "type": "string",
      "description": "Cor hex para display"
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "titulo",
    "data",
    "tipo"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.usuario_id": "{{user.email}}"
        },
        {
          "data.personal_id": "{{user.email}}"
        },
        {
          "data.student_id": "{{user.data.student_id}}"
        },
        {
          "data.student_id": "{{user.email}}"
        },
        {
          "data.student_email": "{{user.email}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.usuario_id": "{{user.email}}"
        },
        {
          "data.personal_id": "{{user.email}}"
        },
        {
          "data.student_id": "{{user.data.student_id}}"
        },
        {
          "data.student_id": "{{user.email}}"
        },
        {
          "data.student_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.usuario_id": "{{user.email}}"
        },
        {
          "data.personal_id": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.usuario_id": "{{user.email}}"
        },
        {
          "data.personal_id": "{{user.email}}"
        }
      ]
    }
  }
}