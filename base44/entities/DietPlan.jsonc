{
  "name": "DietPlan",
  "type": "object",
  "properties": {
    "student_id": {
      "type": "string",
      "description": "ID do aluno"
    },
    "personal_id": {
      "type": "string",
      "description": "Email do Personal respons\u00e1vel"
    },
    "name": {
      "type": "string",
      "description": "Nome do plano (ex: Dieta Bulking)"
    },
    "goal": {
      "type": "string",
      "enum": [
        "bulking",
        "cutting",
        "manutencao"
      ]
    },
    "total_calories": {
      "type": "number"
    },
    "protein_g": {
      "type": "number"
    },
    "carbs_g": {
      "type": "number"
    },
    "fat_g": {
      "type": "number"
    },
    "meals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "time": {
            "type": "string"
          },
          "calories": {
            "type": "number"
          },
          "foods": {
            "type": "string",
            "description": "Campo legado (texto livre)"
          },
          "items": {
            "type": "array",
            "description": "Alimentos individuais da refei\u00e7\u00e3o",
            "items": {
              "type": "object",
              "properties": {
                "food_id": {
                  "type": "string"
                },
                "food_name": {
                  "type": "string"
                },
                "quantity_g": {
                  "type": "number"
                },
                "unit": {
                  "type": "string"
                },
                "calories": {
                  "type": "number"
                },
                "protein_g": {
                  "type": "number"
                },
                "carbs_g": {
                  "type": "number"
                },
                "fat_g": {
                  "type": "number"
                },
                "acao": {
                  "type": "string"
                },
                "motivo": {
                  "type": "string"
                },
                "alimentoAntigoRelacionado": {
                  "type": "string"
                },
                "confiancaEquivalencia": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "notes": {
      "type": "string"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "versao": {
      "type": "number",
      "default": 1
    },
    "dietaAnteriorId": {
      "type": "string"
    },
    "statusVersao": {
      "type": "string",
      "enum": [
        "atual",
        "arquivada",
        "substituida",
        "rascunho"
      ],
      "default": "atual"
    },
    "dataAplicacao": {
      "type": "string"
    },
    "motivoAtualizacao": {
      "type": "string"
    },
    "evoluidaPorIA": {
      "type": "boolean",
      "default": false
    },
    "historicoEvolucaoId": {
      "type": "string"
    },
    "tipoDono": {
      "type": "string",
      "enum": [
        "aluno",
        "assinante"
      ],
      "default": "aluno"
    },
    "usuarioId": {
      "type": "string"
    },
    "assinanteId": {
      "type": "string"
    },
    "alunoId": {
      "type": "string"
    },
    "personalId": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "personal"
          }
        },
        {
          "user_condition": {
            "role": "assinante"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.personal_id": "{{user.email}}"
        },
        {
          "data.personalId": "{{user.email}}"
        },
        {
          "data.usuarioId": "{{user.email}}"
        },
        {
          "data.assinanteId": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.personal_id": "{{user.email}}"
        },
        {
          "data.personalId": "{{user.email}}"
        },
        {
          "data.usuarioId": "{{user.email}}"
        },
        {
          "data.assinanteId": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.personal_id": "{{user.email}}"
        },
        {
          "data.personalId": "{{user.email}}"
        }
      ]
    }
  }
}