{
  "name": "DietPlan",
  "type": "object",
  "properties": {
    "student_id": {
      "type": "string",
      "description": "ID do aluno"
    },
    "personal_id": {
      "type": "string",
      "description": "Email do Personal respons\u00e1vel"
    },
    "name": {
      "type": "string",
      "description": "Nome do plano (ex: Dieta Bulking)"
    },
    "goal": {
      "type": "string",
      "enum": [
        "bulking",
        "cutting",
        "manutencao"
      ]
    },
    "total_calories": {
      "type": "number"
    },
    "protein_g": {
      "type": "number"
    },
    "carbs_g": {
      "type": "number"
    },
    "fat_g": {
      "type": "number"
    },
    "meals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "time": {
            "type": "string"
          },
          "calories": {
            "type": "number"
          },
          "foods": {
            "type": "string"
          }
        }
      }
    },
    "notes": {
      "type": "string"
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "student_id",
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "personal"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.personal_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.personal_id": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.personal_id": "{{user.email}}"
        }
      ]
    }
  }
}