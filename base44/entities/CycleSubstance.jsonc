{
  "name": "CycleSubstance",
  "type": "object",
  "properties": {
    "cycle_id": {
      "type": "string",
      "description": "ID do ciclo"
    },
    "category": {
      "type": "string",
      "description": "Categoria da subst\u00e2ncia",
      "enum": [
        "anabolizante",
        "peptideo",
        "farmaco",
        "hormonio",
        "outro"
      ]
    },
    "substance": {
      "type": "string",
      "description": "Nome da subst\u00e2ncia"
    },
    "ester": {
      "type": "string",
      "description": "\u00c9ster da subst\u00e2ncia",
      "enum": [
        "propionato",
        "fenilpropionato",
        "isocaproato",
        "enantato",
        "cipionato",
        "decanoato",
        "undecanoato",
        "acetato",
        "hexaidrobenzilcarbonato",
        "laurato",
        "buciclato",
        "base",
        "suspensao",
        "sem_ester"
      ]
    },
    "dosage_mg_per_week": {
      "type": "number",
      "description": "Dosagem total em mg por semana"
    },
    "dosage_mg_per_application": {
      "type": "number",
      "description": "Dosagem em mg por aplica\u00e7\u00e3o"
    },
    "dosage_unit": {
      "type": "string",
      "enum": [
        "mg",
        "ui",
        "mcg",
        "iu",
        "ml"
      ],
      "default": "mg",
      "description": "Unidade de dosagem"
    },
    "application_frequency": {
      "type": "string",
      "enum": [
        "1x_semana",
        "2x_semana",
        "3x_semana",
        "dia_sim_dia_nao",
        "diario",
        "2x_dia",
        "conforme_necessario"
      ],
      "description": "Frequ\u00eancia de aplica\u00e7\u00e3o"
    },
    "application_days": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Dias da semana para aplica\u00e7\u00e3o (0=Dom, 1=Seg, ..., 6=Sab)"
    },
    "application_route": {
      "type": "string",
      "enum": [
        "intramuscular",
        "subcutaneo",
        "oral",
        "topico",
        "intravenoso"
      ],
      "description": "Via de administra\u00e7\u00e3o"
    },
    "application_site": {
      "type": "string",
      "description": "Local de aplica\u00e7\u00e3o (ex: gl\u00fateo, deltoide)"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es sobre a subst\u00e2ncia"
    }
  },
  "required": [
    "cycle_id",
    "substance",
    "dosage_mg_per_week",
    "dosage_mg_per_application"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "personal"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "personal"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "assinante"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "personal"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "personal"
          }
        }
      ]
    }
  }
}