{
  "name": "GraficosRelatorioTreino",
  "type": "object",
  "properties": {
    "relatorioEvolucaoTreinoId": {
      "type": "string"
    },
    "usuarioId": {
      "type": "string"
    },
    "assinanteId": {
      "type": "string"
    },
    "tipoGrafico": {
      "type": "string",
      "enum": [
        "adesao",
        "progressao_carga",
        "volume_grupo",
        "status_exercicios",
        "prs",
        "comparativo_volume"
      ]
    },
    "titulo": {
      "type": "string"
    },
    "descricao": {
      "type": "string"
    },
    "dadosJson": {
      "type": "object"
    },
    "imagemGraficoUrl": {
      "type": "string"
    },
    "ordem": {
      "type": "number"
    }
  },
  "required": [
    "relatorioEvolucaoTreinoId",
    "tipoGrafico",
    "titulo"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "personal"
          }
        },
        {
          "user_condition": {
            "role": "assinante"
          }
        },
        {
          "data.usuarioId": "{{user.email}}"
        },
        {
          "data.assinanteId": "{{user.email}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "personal"
          }
        },
        {
          "user_condition": {
            "role": "assinante"
          }
        },
        {
          "data.usuarioId": "{{user.email}}"
        },
        {
          "data.assinanteId": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "personal"
          }
        },
        {
          "data.usuarioId": "{{user.email}}"
        },
        {
          "data.assinanteId": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.usuarioId": "{{user.email}}"
        },
        {
          "data.assinanteId": "{{user.email}}"
        }
      ]
    }
  }
}