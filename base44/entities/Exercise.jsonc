{
  "name": "Exercise",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome do exerc\u00edcio"
    },
    "muscle_group": {
      "type": "string",
      "enum": [
        "peito",
        "costas",
        "ombros",
        "biceps",
        "triceps",
        "pernas",
        "gluteos",
        "abdomen",
        "panturrilha",
        "antebraco",
        "cardio",
        "outro"
      ],
      "description": "Grupo muscular principal"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o ou instru\u00e7\u00e3o do exerc\u00edcio"
    },
    "image_url": {
      "type": "string",
      "description": "URL da imagem, GIF ou foto do exerc\u00edcio"
    },
    "video_url": {
      "type": "string",
      "description": "URL do v\u00eddeo demonstrativo (YouTube embed, MP4, WEBM)"
    }
  },
  "required": [
    "name",
    "muscle_group"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "personal"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "personal"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "personal"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    }
  }
}