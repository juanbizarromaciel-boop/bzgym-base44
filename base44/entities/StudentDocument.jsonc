{
  "name": "StudentDocument",
  "type": "object",
  "properties": {
    "student_id": {
      "type": "string",
      "description": "ID do aluno ou email vinculado"
    },
    "document_type": {
      "type": "string",
      "enum": [
        "foto_perfil",
        "foto_progresso",
        "exame_sangue",
        "bioimpedancia",
        "raio_x",
        "ressonancia",
        "atestado_medico",
        "outro"
      ],
      "description": "Tipo do documento"
    },
    "file_url": {
      "type": "string",
      "description": "URL do arquivo"
    },
    "title": {
      "type": "string",
      "description": "T\u00edtulo ou descri\u00e7\u00e3o do documento"
    },
    "document_date": {
      "type": "string",
      "format": "date",
      "description": "Data do documento/exame"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es sobre o documento"
    }
  },
  "required": [
    "student_id",
    "document_type",
    "file_url"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "personal"
          }
        },
        {
          "data.student_id": "{{user.data.student_id}}"
        },
        {
          "data.student_id": "{{user.email}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "personal"
          }
        },
        {
          "data.student_id": "{{user.data.student_id}}"
        },
        {
          "data.student_id": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "personal"
          }
        },
        {
          "data.student_id": "{{user.data.student_id}}"
        },
        {
          "data.student_id": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "personal"
          }
        },
        {
          "data.student_id": "{{user.data.student_id}}"
        },
        {
          "data.student_id": "{{user.email}}"
        }
      ]
    }
  }
}