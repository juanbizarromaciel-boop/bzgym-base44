{
  "name": "Bioimpedancia",
  "type": "object",
  "properties": {
    "student_id": {
      "type": "string",
      "description": "ID do aluno"
    },
    "personal_id": {
      "type": "string",
      "description": "Email do personal"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Data da avalia\u00e7\u00e3o"
    },
    "weight_kg": {
      "type": "number",
      "description": "Peso em kg"
    },
    "height_cm": {
      "type": "number",
      "description": "Altura em cent\u00edmetros"
    },
    "bmi": {
      "type": "number",
      "description": "\u00cdndice de massa corporal calculado"
    },
    "bmi_classification": {
      "type": "string",
      "description": "Classifica\u00e7\u00e3o do IMC"
    },
    "body_fat_percent": {
      "type": "number",
      "description": "% de gordura corporal"
    },
    "lean_mass_kg": {
      "type": "number",
      "description": "Massa magra em kg"
    },
    "fat_mass_kg": {
      "type": "number",
      "description": "Massa gorda em kg"
    },
    "body_water_percent": {
      "type": "number",
      "description": "% de \u00e1gua corporal"
    },
    "basal_metabolism": {
      "type": "number",
      "description": "Metabolismo basal (kcal)"
    },
    "visceral_fat": {
      "type": "number",
      "description": "Gordura visceral"
    },
    "bone_mass_kg": {
      "type": "number",
      "description": "Massa \u00f3ssea em kg"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    },
    "file_url": {
      "type": "string",
      "description": "URL do arquivo/laudo"
    }
  },
  "required": [
    "student_id",
    "date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "personal"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "assinante"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.personal_id": "{{user.email}}"
        },
        {
          "data.student_id": "{{user.email}}"
        },
        {
          "data.student_id": "{{user.data.student_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.personal_id": "{{user.email}}"
        },
        {
          "data.student_id": "{{user.email}}"
        },
        {
          "data.student_id": "{{user.data.student_id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.personal_id": "{{user.email}}"
        }
      ]
    }
  }
}