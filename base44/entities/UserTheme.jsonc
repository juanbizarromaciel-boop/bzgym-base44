{
  "name": "UserTheme",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email do usu\u00e1rio dono do tema"
    },
    "theme_name": {
      "type": "string",
      "description": "Nome do tema"
    },
    "theme_data": {
      "type": "object",
      "description": "Objeto com todas as vari\u00e1veis CSS do tema"
    },
    "is_active": {
      "type": "boolean",
      "default": false,
      "description": "Se este tema est\u00e1 aplicado atualmente"
    },
    "is_personal_default": {
      "type": "boolean",
      "default": false,
      "description": "Se este tema \u00e9 o padr\u00e3o pessoal do usu\u00e1rio"
    },
    "theme_locked": {
      "type": "boolean",
      "default": false,
      "description": "Admin pode bloquear personaliza\u00e7\u00e3o para este usu\u00e1rio"
    },
    "is_system": {
      "type": "boolean",
      "default": false,
      "description": "Se \u00e9 tema do sistema (n\u00e3o edit\u00e1vel por usu\u00e1rio comum)"
    }
  },
  "required": [
    "user_email",
    "theme_name",
    "theme_data"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.user_email": "{{user.email}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.user_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.user_email": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.user_email": "{{user.email}}"
        }
      ]
    }
  }
}