{
  "name": "ChatMessage",
  "type": "object",
  "properties": {
    "student_id": {
      "type": "string",
      "description": "ID do aluno"
    },
    "sender_email": {
      "type": "string",
      "description": "Email de quem enviou"
    },
    "sender_name": {
      "type": "string",
      "description": "Nome de quem enviou"
    },
    "message": {
      "type": "string",
      "description": "Conte\u00fado da mensagem"
    },
    "image_url": {
      "type": "string",
      "description": "URL da imagem enviada"
    },
    "is_trainer": {
      "type": "boolean",
      "description": "Se foi enviado pelo professor",
      "default": false
    },
    "read": {
      "type": "boolean",
      "description": "Se foi lida",
      "default": false
    }
  },
  "required": [
    "student_id",
    "sender_email"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "personal"
          }
        },
        {
          "data.sender_email": "{{user.email}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "personal"
          }
        },
        {
          "data.sender_email": "{{user.email}}"
        },
        {
          "data.student_id": "{{user.data.student_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "personal"
          }
        },
        {
          "data.sender_email": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.sender_email": "{{user.email}}"
        }
      ]
    }
  }
}