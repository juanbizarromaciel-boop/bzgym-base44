{
  "name": "CalendarioHormonal",
  "type": "object",
  "properties": {
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo do evento"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o vis\u00edvel ao aluno autorizado"
    },
    "student_id": {
      "type": "string",
      "description": "ID do aluno vinculado"
    },
    "personal_id": {
      "type": "string",
      "description": "Email do personal vinculado"
    },
    "criado_por": {
      "type": "string",
      "description": "Email do admin que criou"
    },
    "data_inicio": {
      "type": "string",
      "format": "date"
    },
    "data_fim": {
      "type": "string",
      "format": "date"
    },
    "tipo_evento": {
      "type": "string",
      "enum": [
        "exame",
        "consulta",
        "lembrete",
        "acompanhamento",
        "documento",
        "observacao"
      ],
      "default": "lembrete"
    },
    "status": {
      "type": "string",
      "enum": [
        "ativo",
        "concluido",
        "pausado",
        "cancelado"
      ],
      "default": "ativo"
    },
    "visivel_para_aluno": {
      "type": "boolean",
      "default": false,
      "description": "Se o aluno pode visualizar este evento"
    },
    "visivel_para_personal": {
      "type": "boolean",
      "default": false,
      "description": "Se o personal pode visualizar este evento"
    },
    "autorizado_por_admin": {
      "type": "boolean",
      "default": false
    },
    "arquivo_url": {
      "type": "string",
      "description": "Documento ou exame anexado"
    },
    "observacoes_privadas_admin": {
      "type": "string",
      "description": "Notas internas \u2014 NUNCA vis\u00edveis ao aluno ou personal"
    },
    "observacoes_visiveis_aluno": {
      "type": "string",
      "description": "Notas que o aluno autorizado pode ver"
    }
  },
  "required": [
    "titulo",
    "student_id",
    "data_inicio"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.personal_id": "{{user.email}}"
        },
        {
          "data.student_id": "{{user.email}}"
        },
        {
          "data.student_id": "{{user.data.student_id}}"
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}