{
  "name": "CiclosTreino",
  "type": "object",
  "properties": {
    "alunoId": {
      "type": "string"
    },
    "personalId": {
      "type": "string"
    },
    "nomeCiclo": {
      "type": "string"
    },
    "objetivo": {
      "type": "string"
    },
    "divisao": {
      "type": "string"
    },
    "dataInicio": {
      "type": "string"
    },
    "dataFim": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "atual",
        "arquivado",
        "rascunho",
        "substituido"
      ],
      "default": "rascunho"
    },
    "cicloAnteriorId": {
      "type": "string"
    },
    "criadoPorIA": {
      "type": "boolean",
      "default": false
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "alunoId",
    "personalId",
    "nomeCiclo"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "personal"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.personalId": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.personalId": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}