{
  "name": "HistoricoEvolucaoTreinoIA",
  "type": "object",
  "properties": {
    "alunoId": {
      "type": "string"
    },
    "personalId": {
      "type": "string"
    },
    "modoEvolucao": {
      "type": "string",
      "enum": [
        "treino_especifico",
        "plano_completo"
      ],
      "default": "treino_especifico"
    },
    "treinosAntigosIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "treinosNovosIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dataEvolucao": {
      "type": "string"
    },
    "motivoEvolucao": {
      "type": "string"
    },
    "pedidoIA": {
      "type": "string"
    },
    "resumoAnalise": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "rascunho",
        "aplicado",
        "cancelado"
      ],
      "default": "rascunho"
    },
    "criadoPor": {
      "type": "string"
    },
    "aprovadoPor": {
      "type": "string"
    },
    "relatorioUrl": {
      "type": "string"
    },
    "relatorioTexto": {
      "type": "string"
    }
  },
  "required": [
    "alunoId",
    "personalId",
    "modoEvolucao",
    "dataEvolucao"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "personal"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.personalId": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.personalId": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}