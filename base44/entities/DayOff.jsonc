{
  "name": "DayOff",
  "type": "object",
  "properties": {
    "employee_name": {
      "type": "string",
      "description": "Nome do funcion\u00e1rio"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Data da folga"
    },
    "status": {
      "type": "string",
      "enum": [
        "disponivel",
        "usada"
      ],
      "default": "disponivel",
      "description": "Status da folga"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    }
  },
  "required": [
    "employee_name",
    "date",
    "status"
  ]
}