{
  "name": "WorkHour",
  "type": "object",
  "properties": {
    "employee_name": {
      "type": "string",
      "description": "Nome do funcion\u00e1rio"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Data do registro"
    },
    "hours_worked": {
      "type": "number",
      "description": "Horas trabalhadas (valor real)"
    },
    "is_sunday": {
      "type": "boolean",
      "description": "Se \u00e9 domingo",
      "default": false
    },
    "is_holiday": {
      "type": "boolean",
      "description": "Se \u00e9 feriado",
      "default": false
    },
    "holiday_name": {
      "type": "string",
      "description": "Nome do feriado (se aplic\u00e1vel)"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    }
  },
  "required": [
    "employee_name",
    "date",
    "hours_worked"
  ]
}