{
  "name": "Payment",
  "type": "object",
  "properties": {
    "student_id": {
      "type": "string",
      "description": "ID do aluno"
    },
    "user_email": {
      "type": "string",
      "description": "Email do assinante/personal/aluno cobrado"
    },
    "user_name": {
      "type": "string"
    },
    "user_role": {
      "type": "string",
      "enum": [
        "user",
        "assinante",
        "personal",
        "admin"
      ],
      "default": "user"
    },
    "personal_id": {
      "type": "string",
      "description": "Email do Admin ou Personal respons\u00e1vel"
    },
    "amount": {
      "type": "number",
      "description": "Valor pago em R$"
    },
    "payment_date": {
      "type": "string",
      "format": "date",
      "description": "Data do pagamento"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "Data de vencimento"
    },
    "next_due_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "pago",
        "pendente",
        "atrasado",
        "bloqueado",
        "cancelado"
      ],
      "default": "pendente",
      "description": "Status do pagamento"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o (ex: Mensalidade Maio/2025)"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "manual",
        "stripe"
      ],
      "default": "manual"
    },
    "stripe_checkout_session_id": {
      "type": "string"
    },
    "stripe_customer_id": {
      "type": "string"
    },
    "stripe_subscription_id": {
      "type": "string"
    },
    "stripe_payment_intent_id": {
      "type": "string"
    },
    "checkout_url": {
      "type": "string"
    }
  },
  "required": [
    "due_date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.personal_id": "{{user.email}}"
        },
        {
          "data.user_email": "{{user.email}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.personal_id": "{{user.email}}"
        },
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "data.student_id": "{{user.email}}"
        },
        {
          "data.student_id": "{{user.data.student_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.personal_id": "{{user.email}}"
        },
        {
          "data.user_email": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.personal_id": "{{user.email}}"
        }
      ]
    }
  }
}