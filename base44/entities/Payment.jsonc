{
  "name": "Payment",
  "type": "object",
  "properties": {
    "student_id": {
      "type": "string",
      "description": "ID do aluno"
    },
    "personal_id": {
      "type": "string",
      "description": "Email do personal respons\u00e1vel"
    },
    "amount": {
      "type": "number",
      "description": "Valor pago em R$"
    },
    "payment_date": {
      "type": "string",
      "format": "date",
      "description": "Data do pagamento"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "Data de vencimento"
    },
    "status": {
      "type": "string",
      "enum": [
        "pago",
        "pendente",
        "atrasado"
      ],
      "default": "pendente",
      "description": "Status do pagamento"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o (ex: Mensalidade Maio/2025)"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    }
  },
  "required": [
    "student_id",
    "personal_id",
    "due_date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "personal"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.personal_id": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.personal_id": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.personal_id": "{{user.email}}"
        }
      ]
    }
  }
}