{
  "name": "Cycle",
  "type": "object",
  "properties": {
    "student_id": {
      "type": "string",
      "description": "ID do aluno"
    },
    "name": {
      "type": "string",
      "description": "Nome do ciclo"
    },
    "cycle_start_date": {
      "type": "string",
      "format": "date",
      "description": "Data de in\u00edcio do ciclo"
    },
    "cycle_duration_weeks": {
      "type": "number",
      "description": "Dura\u00e7\u00e3o do ciclo em semanas"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es adicionais"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Se o ciclo est\u00e1 ativo"
    }
  },
  "required": [
    "student_id",
    "name",
    "cycle_start_date"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "personal"
          }
        },
        {
          "data.student_id": "{{user.email}}"
        },
        {
          "data.student_id": "{{user.data.student_id}}"
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}