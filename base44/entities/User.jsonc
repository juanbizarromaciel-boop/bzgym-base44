{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "personal",
        "user",
        "assinante",
        "recente",
        "bloqueado"
      ],
      "default": "recente",
      "description": "Cargo do usu\u00e1rio"
    },
    "student_id": {
      "type": "string",
      "description": "ID do registro Student vinculado a este usu\u00e1rio"
    },
    "account_type": {
      "type": "string",
      "enum": [
        "aluno",
        "assinante"
      ],
      "description": "Tipo de entrada escolhido no onboarding"
    },
    "goal": {
      "type": "string",
      "description": "Objetivo informado no onboarding"
    },
    "phone": {
      "type": "string"
    },
    "training_level": {
      "type": "string"
    },
    "restrictions": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "assinatura_status": {
      "type": "string",
      "enum": [
        "ativa",
        "pendente",
        "atrasada",
        "bloqueada",
        "isenta"
      ],
      "default": "pendente"
    },
    "assinatura_origem": {
      "type": "string",
      "enum": [
        "nenhuma",
        "manual",
        "stripe"
      ],
      "default": "nenhuma",
      "description": "Indica se a assinatura foi liberada manualmente pelo admin ou paga via Stripe"
    },
    "assinatura_bloqueio_manual": {
      "type": "boolean",
      "default": false,
      "description": "Bloqueio manual aplicado pelo admin"
    },
    "assinatura_liberado_manual_por": {
      "type": "string"
    },
    "assinatura_plano": {
      "type": "string",
      "enum": [
        "monthly",
        "yearly",
        "manual"
      ]
    },
    "assinatura_vencimento": {
      "type": "string",
      "format": "date"
    },
    "assinatura_valor": {
      "type": "number"
    },
    "stripe_customer_id": {
      "type": "string"
    },
    "stripe_subscription_id": {
      "type": "string"
    }
  },
  "required": []
}