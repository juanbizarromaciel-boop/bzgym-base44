{
  "name": "WorkoutPlan",
  "type": "object",
  "properties": {
    "student_id": {
      "type": "string",
      "description": "ID do aluno ou email do assinante"
    },
    "personal_id": {
      "type": "string",
      "description": "Email do Personal respons\u00e1vel"
    },
    "name": {
      "type": "string",
      "description": "Nome do treino (ex: Treino A - Peito/Tr\u00edceps)"
    },
    "day_of_week": {
      "type": "string",
      "enum": [
        "segunda",
        "terca",
        "quarta",
        "quinta",
        "sexta",
        "sabado",
        "domingo"
      ],
      "description": "Dia da semana"
    },
    "exercises": {
      "type": "array",
      "description": "Lista de exerc\u00edcios do treino",
      "items": {
        "type": "object",
        "properties": {
          "exercise_id": {
            "type": "string"
          },
          "exercise_name": {
            "type": "string"
          },
          "sets": {
            "type": "number"
          },
          "reps": {
            "type": "string"
          },
          "load_kg": {
            "type": "number"
          },
          "rest_seconds": {
            "type": "number"
          },
          "technique": {
            "type": "string",
            "enum": [
              "normal",
              "cluster",
              "rest_pause",
              "drop_set",
              "super_set",
              "giant_set",
              "piramidal",
              "fst7",
              "myo_reps",
              "tempo_controlado"
            ]
          },
          "technique_details": {
            "type": "string"
          },
          "order": {
            "type": "number"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "versao": {
      "type": "number",
      "default": 1,
      "description": "Vers\u00e3o do treino"
    },
    "treinoAnteriorId": {
      "type": "string",
      "description": "ID do treino anterior usado como base"
    },
    "cicloId": {
      "type": "string",
      "description": "ID do ciclo de treino"
    },
    "statusVersao": {
      "type": "string",
      "enum": [
        "atual",
        "arquivado",
        "substituido",
        "rascunho"
      ],
      "default": "atual"
    },
    "dataAplicacao": {
      "type": "string",
      "description": "Data em que a vers\u00e3o foi aplicada"
    },
    "motivoAtualizacao": {
      "type": "string",
      "description": "Motivo da atualiza\u00e7\u00e3o do treino"
    },
    "evoluidoPorIA": {
      "type": "boolean",
      "default": false
    },
    "historicoEvolucaoId": {
      "type": "string",
      "description": "ID do hist\u00f3rico de evolu\u00e7\u00e3o com IA"
    },
    "tipoDono": {
      "type": "string",
      "enum": [
        "aluno",
        "assinante"
      ],
      "default": "aluno"
    },
    "usuarioId": {
      "type": "string"
    },
    "assinanteId": {
      "type": "string"
    }
  },
  "required": [
    "student_id",
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "personal"
          }
        },
        {
          "data.personal_id": "{{user.email}}"
        },
        {
          "data.usuarioId": "{{user.email}}"
        },
        {
          "data.assinanteId": "{{user.email}}"
        },
        {
          "data.student_id": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.personal_id": "{{user.email}}"
        },
        {
          "data.usuarioId": "{{user.email}}"
        },
        {
          "data.assinanteId": "{{user.email}}"
        },
        {
          "data.student_id": "{{user.email}}"
        },
        {
          "data.student_id": "{{user.data.student_id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.personal_id": "{{user.email}}"
        },
        {
          "data.usuarioId": "{{user.email}}"
        },
        {
          "data.assinanteId": "{{user.email}}"
        },
        {
          "data.student_id": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.personal_id": "{{user.email}}"
        },
        {
          "data.usuarioId": "{{user.email}}"
        },
        {
          "data.assinanteId": "{{user.email}}"
        },
        {
          "data.student_id": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    }
  }
}