{
  "name": "SugestaoNovoTreinoIA",
  "type": "object",
  "properties": {
    "alunoId": {
      "type": "string"
    },
    "personalId": {
      "type": "string"
    },
    "assinanteId": {
      "type": "string"
    },
    "usuarioId": {
      "type": "string"
    },
    "treinoBaseId": {
      "type": "string"
    },
    "evolucaoCompletaId": {
      "type": "string"
    },
    "nomeSugestao": {
      "type": "string"
    },
    "objetivo": {
      "type": "string"
    },
    "divisao": {
      "type": "string"
    },
    "pedidoIA": {
      "type": "string"
    },
    "configuracoesSelecionadas": {
      "type": "object"
    },
    "status": {
      "type": "string",
      "enum": [
        "gerado",
        "em_revisao",
        "aprovado",
        "aplicado",
        "descartado"
      ],
      "default": "gerado"
    },
    "dataCriacao": {
      "type": "string"
    },
    "criadoPor": {
      "type": "string"
    }
  },
  "required": [
    "alunoId",
    "personalId",
    "nomeSugestao"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "personal"
          }
        },
        {
          "data.personalId": "{{user.email}}"
        },
        {
          "data.usuarioId": "{{user.email}}"
        },
        {
          "data.assinanteId": "{{user.email}}"
        },
        {
          "data.alunoId": "{{user.email}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.personalId": "{{user.email}}"
        },
        {
          "data.usuarioId": "{{user.email}}"
        },
        {
          "data.assinanteId": "{{user.email}}"
        },
        {
          "data.alunoId": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.personalId": "{{user.email}}"
        },
        {
          "data.usuarioId": "{{user.email}}"
        },
        {
          "data.assinanteId": "{{user.email}}"
        },
        {
          "data.alunoId": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.usuarioId": "{{user.email}}"
        },
        {
          "data.assinanteId": "{{user.email}}"
        },
        {
          "data.alunoId": "{{user.email}}"
        }
      ]
    }
  }
}