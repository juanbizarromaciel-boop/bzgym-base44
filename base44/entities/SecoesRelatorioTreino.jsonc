{
  "name": "SecoesRelatorioTreino",
  "type": "object",
  "properties": {
    "relatorioEvolucaoTreinoId": {
      "type": "string"
    },
    "titulo": {
      "type": "string"
    },
    "tipoSecao": {
      "type": "string",
      "enum": [
        "capa",
        "resumo",
        "grafico",
        "tabela",
        "analise",
        "comparativo",
        "alerta",
        "conclusao"
      ]
    },
    "conteudoHtml": {
      "type": "string"
    },
    "dadosJson": {
      "type": "object"
    },
    "ordem": {
      "type": "number"
    },
    "visivelNoPdf": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "relatorioEvolucaoTreinoId",
    "titulo",
    "tipoSecao"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "personal"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "personal"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "personal"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}